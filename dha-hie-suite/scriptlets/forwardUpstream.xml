<?xml version="1.0" encoding="UTF-8"?>
<scriptlet id="forwardUpstream" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Forward an EMR call to the HIE upstream</gitb:name>
        <gitb:description>Sends the received call unchanged (method, path, query, Authorization,
            Content-Type, facility headers, body) to hieBaseUrl and returns the upstream status,
            Content-Type and body. Used inside receive result blocks.</gitb:description>
    </metadata>
    <params>
        <var name="request" type="map"/>
        <var name="hideRequestBody" type="boolean"><value>false</value></var>
    </params>
    <steps>
        <call id="incoming" path="scriptlets/normaliseRequest.xml" hidden="true">
            <input name="request">$request</input>
        </call>
        <assign to="method" type="string">upper-case($request{method})</assign>
        <assign to="upstreamUri" type="string">$DOMAIN{hieBaseUrl} || $incoming{path} || (if ($incoming{queryString} = '') then '' else '?' || $incoming{queryString})</assign>
        <assign to="upstreamHeaders{Accept}" type="string">'application/json'</assign>
        <if desc="Forward Authorization" hidden="true">
            <cond>$incoming{headers}{Authorization} != ''</cond>
            <then><assign to="upstreamHeaders{Authorization}" type="string">$incoming{headers}{Authorization}</assign></then>
        </if>
        <if desc="Forward Content-Type" hidden="true">
            <cond>$incoming{headers}{Content-Type} != ''</cond>
            <then><assign to="upstreamHeaders{Content-Type}" type="string">$incoming{headers}{Content-Type}</assign></then>
        </if>
        <if desc="Forward X-Facility-Id" hidden="true">
            <cond>$incoming{headers}{X-Facility-Id} != ''</cond>
            <then><assign to="upstreamHeaders{X-Facility-Id}" type="string">$incoming{headers}{X-Facility-Id}</assign></then>
        </if>
        <if desc="Forward X-Facility-Id-Type" hidden="true">
            <cond>$incoming{headers}{X-Facility-Id-Type} != ''</cond>
            <then><assign to="upstreamHeaders{X-Facility-Id-Type}" type="string">$incoming{headers}{X-Facility-Id-Type}</assign></then>
        </if>
        <if desc="Forward to the HIE upstream">
            <cond>$method = 'POST'</cond>
            <then>
                <send id="upstreamPost" desc="Forward to the HIE upstream" handler="HttpMessagingV2">
                    <input name="uri">$upstreamUri</input>
                    <input name="method">"POST"</input>
                    <input name="version">"1.1"</input>
                    <input name="headers">$upstreamHeaders</input>
                    <input name="body">$request{body}</input>
                    <input name="showRequestBody">not($hideRequestBody)</input>
                    <input name="requestHeadersToHide">"Authorization"</input>
                </send>
                <assign to="status">$upstreamPost{response}{status}</assign>
                <assign to="body">$upstreamPost{response}{body}</assign>
                <assign to="contentType" type="string">if ($upstreamPost{response}{headers}{Content-Type} != '') then $upstreamPost{response}{headers}{Content-Type} else $upstreamPost{response}{headers}{content-type}</assign>
            </then>
            <else>
                <send id="upstreamGet" desc="Forward to the HIE upstream" handler="HttpMessagingV2">
                    <input name="uri">$upstreamUri</input>
                    <input name="method">$method</input>
                    <input name="version">"1.1"</input>
                    <input name="headers">$upstreamHeaders</input>
                    <input name="requestHeadersToHide">"Authorization"</input>
                </send>
                <assign to="status">$upstreamGet{response}{status}</assign>
                <assign to="body">$upstreamGet{response}{body}</assign>
                <assign to="contentType" type="string">if ($upstreamGet{response}{headers}{Content-Type} != '') then $upstreamGet{response}{headers}{Content-Type} else $upstreamGet{response}{headers}{content-type}</assign>
            </else>
        </if>
        <if desc="Default the reply Content-Type" hidden="true">
            <cond>$contentType = ''</cond>
            <then><assign to="contentType" type="string">'application/json'</assign></then>
        </if>
    </steps>
    <output name="status"/>
    <output name="body"/>
    <output name="contentType"/>
</scriptlet>
