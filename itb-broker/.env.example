# ITB Automation Broker environment variables.
# Add these to the top-level .env used by docker compose (do not commit real values).

# Broker database
BROKER_DB_USERNAME=broker
BROKER_DB_PASSWORD=<strong-password>

# ITB (internal container address of gitb-srv)
ITB_BASE_URL=http://itb-srv:8080

# Certification Portal
PORTAL_BASE_URL=https://certification.dha.go.ke
PORTAL_API_KEY=<portal-api-key>
