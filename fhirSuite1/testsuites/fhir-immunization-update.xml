<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCaseImmunizationUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Immunization (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of an Immunization resource update (HTTP PUT) and subsequent fetch (HTTP GET)
            against the KPS Implementation Guide. The client system first submits a new Immunization
            for creation. The server-assigned ID from that response is then used to build the update
            URL (Immunization/{id}), which the client must call next with its update payload, followed
            by a read request to confirm the update was applied.
        </gitb:description>
    </metadata>
    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>
    <steps>
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>

        <receive id="receiveImmunizationCreate" desc="Receive new Immunization payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Immunization"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardImmunizationCreateToHAPI" desc="Forward new Immunization to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Immunization"</input>
            <input name="method">"POST"</input>
            <input name="body">$receiveImmunizationCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate Immunization was created">
            <input name="actual">$forwardImmunizationCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractImmunizationId" handler="JsonPathProcessor" operation="process" output="immunizationId" desc="Extract server-assigned Immunization ID">
            <input name="content">$forwardImmunizationCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receiveImmunizationUpdate" desc="Receive Immunization update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Immunization/" || $immunizationId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardImmunizationUpdateToHAPI" desc="Forward Immunization update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Immunization/" || $immunizationId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receiveImmunizationUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardImmunizationUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receiveImmunizationRead" desc="Receive Immunization read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/Immunization/" || $immunizationId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardImmunizationReadToHAPI" desc="Forward Immunization read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Immunization/" || $immunizationId</input>
            <input name="method">"GET"</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardImmunizationReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <assign to="hapiResponse">$forwardImmunizationReadToHAPI{response}{body}</assign>
    </steps>

    <output>
        <success>
            <default>$hapiResponse</default>
        </success>
        <failure>
            <default>$hapiResponse</default>
        </failure>
    </output>
</testcase>
