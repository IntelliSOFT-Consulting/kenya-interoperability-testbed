<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCasePatientUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">

    <metadata>
        <gitb:name>Patient (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of a Patient resource update (HTTP PUT) and subsequent fetch (HTTP GET) against
            the KPS Implementation Guide. The client system first submits a new Patient for creation.
            The server-assigned ID from that response is then used to build the update URL
            (Patient/{id}), which the client must call next with its update payload, followed by a
            read request to confirm the update was applied.
        </gitb:description>
    </metadata>

    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>

    <steps>
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>

        <receive id="receivePatientCreate" desc="Receive new patient payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Patient"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardCreateToHAPI" desc="Forward new patient to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Patient"</input>
            <input name="method">"POST"</input>
            <input name="body">$receivePatientCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate patient was created">
            <input name="actual">$forwardCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractPatientId" handler="JsonPathProcessor" operation="process" output="patientId" desc="Extract server-assigned patient ID">
            <input name="content">$forwardCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receivePatientUpdate" desc="Receive patient update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Patient/" || $patientId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardUpdateToHAPI" desc="Forward patient update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Patient/" || $patientId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receivePatientUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receivePatientRead" desc="Receive patient read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/Patient/" || $patientId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardReadToHAPI" desc="Forward patient read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Patient/" || $patientId</input>
            <input name="method">"GET"</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <assign to="hapiResponse">$forwardReadToHAPI{response}{body}</assign>
    </steps>

    <output>
        <success>
            <default>$hapiResponse</default>
        </success>
        <failure>
            <default>$hapiResponse</default>
        </failure>
    </output>

</testcase>
