<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCaseMedicationUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Medication (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of a Medication resource update (HTTP PUT) and subsequent fetch (HTTP GET)
            against the KPS Implementation Guide. The client system first submits a new Medication for
            creation. The server-assigned ID from that response is then used to build the update URL
            (Medication/{id}), which the client must call next with its update payload, followed by a
            read request to confirm the update was applied.
        </gitb:description>
    </metadata>
    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>
    <steps>
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>

        <receive id="receiveMedicationCreate" desc="Receive new Medication payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Medication"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardMedicationCreateToHAPI" desc="Forward new Medication to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Medication"</input>
            <input name="method">"POST"</input>
            <input name="body">$receiveMedicationCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate Medication was created">
            <input name="actual">$forwardMedicationCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractMedicationId" handler="JsonPathProcessor" operation="process" output="medicationId" desc="Extract server-assigned Medication ID">
            <input name="content">$forwardMedicationCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receiveMedicationUpdate" desc="Receive Medication update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Medication/" || $medicationId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardMedicationUpdateToHAPI" desc="Forward Medication update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Medication/" || $medicationId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receiveMedicationUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardMedicationUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receiveMedicationRead" desc="Receive Medication read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/Medication/" || $medicationId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardMedicationReadToHAPI" desc="Forward Medication read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Medication/" || $medicationId</input>
            <input name="method">"GET"</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardMedicationReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <assign to="hapiResponse">$forwardMedicationReadToHAPI{response}{body}</assign>
    </steps>

    <output>
        <success>
            <default>$hapiResponse</default>
        </success>
        <failure>
            <default>$hapiResponse</default>
        </failure>
    </output>
</testcase>
