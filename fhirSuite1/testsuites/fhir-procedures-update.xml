<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCaseProcedureUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Procedure (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of a Procedure resource update (HTTP PUT) and subsequent fetch (HTTP GET)
            against the KPS Implementation Guide. The client system first submits a new Procedure for
            creation. The server-assigned ID from that response is then used to build the update URL
            (Procedure/{id}), which the client must call next with its update payload, followed by a
            read request to confirm the update was applied.
        </gitb:description>
    </metadata>
    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>
    <steps>
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>

        <receive id="receiveProcedureCreate" desc="Receive new Procedure payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Procedure"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardProcedureCreateToHAPI" desc="Forward new Procedure to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Procedure"</input>
            <input name="method">"POST"</input>
            <input name="body">$receiveProcedureCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate Procedure was created">
            <input name="actual">$forwardProcedureCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractProcedureId" handler="JsonPathProcessor" operation="process" output="procedureId" desc="Extract server-assigned Procedure ID">
            <input name="content">$forwardProcedureCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receiveProcedureUpdate" desc="Receive Procedure update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Procedure/" || $procedureId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardProcedureUpdateToHAPI" desc="Forward Procedure update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Procedure/" || $procedureId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receiveProcedureUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardProcedureUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receiveProcedureRead" desc="Receive Procedure read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/Procedure/" || $procedureId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardProcedureReadToHAPI" desc="Forward Procedure read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Procedure/" || $procedureId</input>
            <input name="method">"GET"</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardProcedureReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <assign to="hapiResponse">$forwardProcedureReadToHAPI{response}{body}</assign>
    </steps>

    <output>
        <success>
            <default>$hapiResponse</default>
        </success>
        <failure>
            <default>$hapiResponse</default>
        </failure>
    </output>
</testcase>
