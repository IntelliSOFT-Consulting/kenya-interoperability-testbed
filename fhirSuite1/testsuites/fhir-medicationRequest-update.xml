<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCaseMedicationRequestUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">

    <metadata>
        <gitb:name>MedicationRequest (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of a MedicationRequest resource update (HTTP PUT) and subsequent fetch
            (HTTP GET) against the KPS Implementation Guide. The client system first submits a new
            MedicationRequest for creation. The server-assigned ID from that response is then used to
            build the update URL (MedicationRequest/{id}), which the client must call next with its
            update payload, followed by a read request to confirm the update was applied.
        </gitb:description>
    </metadata>

    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>

    <steps>
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>

        <receive id="receiveMedicationRequestCreate" desc="Receive new MedicationRequest payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/MedicationRequest"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardMedicationRequestCreateToHAPI" desc="Forward new MedicationRequest to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/MedicationRequest"</input>
            <input name="method">"POST"</input>
            <input name="body">$receiveMedicationRequestCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <assign to="lastStatus">$forwardMedicationRequestCreateToHAPI{response}{status}</assign>
        <assign to="lastBody">$forwardMedicationRequestCreateToHAPI{response}{body}</assign>

        <verify handler="StringValidator" desc="Validate MedicationRequest was created">
            <input name="actual">$forwardMedicationRequestCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractMedicationRequestId" handler="JsonPathProcessor" operation="process" output="medicationRequestId" desc="Extract server-assigned MedicationRequest ID">
            <input name="content">$forwardMedicationRequestCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receiveMedicationRequestUpdate" desc="Receive MedicationRequest update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/MedicationRequest/" || $medicationRequestId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardMedicationRequestUpdateToHAPI" desc="Forward MedicationRequest update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/MedicationRequest/" || $medicationRequestId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receiveMedicationRequestUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <assign to="lastStatus">$forwardMedicationRequestUpdateToHAPI{response}{status}</assign>
        <assign to="lastBody">$forwardMedicationRequestUpdateToHAPI{response}{body}</assign>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardMedicationRequestUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receiveMedicationRequestRead" desc="Receive MedicationRequest read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/MedicationRequest/" || $medicationRequestId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardMedicationRequestReadToHAPI" desc="Forward MedicationRequest read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/MedicationRequest/" || $medicationRequestId</input>
            <input name="method">"GET"</input>
        </send>

        <assign to="lastStatus">$forwardMedicationRequestReadToHAPI{response}{status}</assign>
        <assign to="lastBody">$forwardMedicationRequestReadToHAPI{response}{body}</assign>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardMedicationRequestReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

    </steps>

    <output>
        <success>
            <default>"HTTP " || $lastStatus || " - " || $lastBody</default>
        </success>
        <failure>
            <default>"HTTP " || $lastStatus || " - " || $lastBody</default>
        </failure>
    </output>

</testcase>
