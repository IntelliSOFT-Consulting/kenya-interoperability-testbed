<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCaseCarePlanUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>CarePlan (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of a CarePlan resource update (HTTP PUT) and subsequent fetch (HTTP GET)
            against the KPS Implementation Guide. The client system first submits a new CarePlan for
            creation. The server-assigned ID from that response is then used to build the update URL
            (CarePlan/{id}), which the client must call next with its update payload, followed by a
            read request to confirm the update was applied.
        </gitb:description>
    </metadata>
    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>
    <steps>
        <assign to="httpHeaders{Content-Type}">"application/json"</assign>

        <receive id="receiveCarePlanCreate" desc="Receive new CarePlan payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/CarePlan"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardCarePlanCreateToHAPI" desc="Forward new CarePlan to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/CarePlan"</input>
            <input name="method">"POST"</input>
            <input name="body">$receiveCarePlanCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate CarePlan was created">
            <input name="actual">$forwardCarePlanCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractCarePlanId" handler="JsonPathProcessor" operation="process" output="carePlanId" desc="Extract server-assigned CarePlan ID">
            <input name="content">$forwardCarePlanCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receiveCarePlanUpdate" desc="Receive CarePlan update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/CarePlan/" || $carePlanId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardCarePlanUpdateToHAPI" desc="Forward CarePlan update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/CarePlan/" || $carePlanId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receiveCarePlanUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardCarePlanUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receiveCarePlanRead" desc="Receive CarePlan read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/CarePlan/" || $carePlanId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardCarePlanReadToHAPI" desc="Forward CarePlan read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/CarePlan/" || $carePlanId</input>
            <input name="method">"GET"</input>
        </send>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardCarePlanReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <assign to="hapiResponse">$forwardCarePlanReadToHAPI{response}{body}</assign>
    </steps>

    <output>
        <success>
            <default>$hapiResponse</default>
        </success>
        <failure>
            <default>$hapiResponse</default>
        </failure>
    </output>
</testcase>
