<?xml version="1.0" encoding="UTF-8"?>
<testcase id="testCaseBundleUpdate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <gitb:name>Bundle (KPS)</gitb:name>
        <gitb:version>1.0</gitb:version>
        <gitb:description>
            Validation of a Bundle resource update (HTTP PUT) and subsequent fetch (HTTP GET) against
            the KPS Implementation Guide. The client system first submits a new Bundle for creation.
            The server-assigned ID from that response is then used to build the update URL
            (Bundle/{id}), which the client must call next with its update payload, followed by a
            read request to confirm the update was applied.
        </gitb:description>
    </metadata>

    <actors>
        <gitb:actor id="ClientSystem" name="Client System" role="SUT"/>
        <gitb:actor id="HAPIServer" name="HAPI Server"/>
    </actors>

    <steps>
        <assign to="httpHeaders{Content-Type}">"application/fhir+json"</assign>

        <receive id="receiveBundleCreate" desc="Receive new Bundle payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Bundle"</input>
            <input name="method">"POST"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardBundleCreateToHAPI" desc="Forward new Bundle to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Bundle"</input>
            <input name="method">"POST"</input>
            <input name="body">$receiveBundleCreate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <assign to="lastStatus">$forwardBundleCreateToHAPI{response}{status}</assign>
        <assign to="lastBody">$forwardBundleCreateToHAPI{response}{body}</assign>

        <verify handler="StringValidator" desc="Validate Bundle was created">
            <input name="actual">$forwardBundleCreateToHAPI{response}{status}</input>
            <input name="expected">"201"</input>
        </verify>

        <process id="extractBundleId" handler="JsonPathProcessor" operation="process" output="bundleId" desc="Extract server-assigned Bundle ID">
            <input name="content">$forwardBundleCreateToHAPI{response}{body}</input>
            <input name="expression">"$.id"</input>
        </process>

        <receive id="receiveBundleUpdate" desc="Receive Bundle update payload" handler="HttpMessagingV2">
            <input name="uriExtension">"/Bundle/" || $bundleId</input>
            <input name="method">"PUT"</input>
            <input name="status">200</input>
            <input name="headers">$httpHeaders</input>
        </receive>

        <send id="forwardBundleUpdateToHAPI" desc="Forward Bundle update to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Bundle/" || $bundleId</input>
            <input name="method">"PUT"</input>
            <input name="body">$receiveBundleUpdate{request}{body}</input>
            <input name="headers">$httpHeaders</input>
        </send>

        <assign to="lastStatus">$forwardBundleUpdateToHAPI{response}{status}</assign>
        <assign to="lastBody">$forwardBundleUpdateToHAPI{response}{body}</assign>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardBundleUpdateToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

        <receive id="receiveBundleRead" desc="Receive Bundle read request" handler="HttpMessagingV2">
            <input name="uriExtension">"/Bundle/" || $bundleId</input>
            <input name="method">"GET"</input>
            <input name="status">200</input>
        </receive>

        <send id="forwardBundleReadToHAPI" desc="Forward Bundle read request to HAPI server" handler="HttpMessagingV2">
            <input name="uri">"http://hapi-fhir-kenyaitb:8080/fhir/Bundle/" || $bundleId</input>
            <input name="method">"GET"</input>
        </send>

        <assign to="lastStatus">$forwardBundleReadToHAPI{response}{status}</assign>
        <assign to="lastBody">$forwardBundleReadToHAPI{response}{body}</assign>

        <verify handler="StringValidator" desc="Validate server response status">
            <input name="actual">$forwardBundleReadToHAPI{response}{status}</input>
            <input name="expected">"200"</input>
        </verify>

    </steps>

    <output>
        <success>
            <default>"HTTP " || $lastStatus || " - " || $lastBody</default>
        </success>
        <failure>
            <default>"HTTP " || $lastStatus || " - " || $lastBody</default>
        </failure>
    </output>
</testcase>
